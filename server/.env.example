# PostgreSQL connection (docker compose up -d gives you this one)
DATABASE_URL="postgresql://bookleaf:bookleaf@localhost:5433/bookleaf?schema=public"

# Any long random string. Used to sign login tokens.
JWT_SECRET="change-me-to-a-long-random-string"

# Optional. Without it the app runs in "fallback mode":
# keyword-based classification + template drafts. Everything else works.
ANTHROPIC_API_KEY=""
AI_MODEL="claude-haiku-5-5"

PORT=4000
